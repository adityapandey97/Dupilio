# Dupilio Environment Configuration Template
PORT=5000
NODE_ENV=development

# Database Configuration
# If MONGODB_URI is left empty or offline, Dupilio falls back to local file-based sandbox storage in ./db_sandbox
MONGODB_URI=mongodb://localhost:27017/dupilio

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379

# Authentication Secrets
JWT_SECRET=dupilio_production_secure_jwt_secret_key_change_me
JWT_EXPIRE=30d

# Google Gemini AI Integration
GEMINI_API_KEY=

# Python AI Microservice URL
PYTHON_ENGINE_URL=http://127.0.0.1:8000

# Optional Third-Party Integration Credentials
GITHUB_TOKEN=
